{
  "name": "@hexlet/fastify-method-override",
  "version": "2.0.0",
  "description": "fastify plugin that overrides the HTTP verb of a POST request by the _method field",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest run && pnpm run test:smoke",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:smoke": "node __tests__/smoke.mjs"
  },
  "keywords": [
    "override",
    "http",
    "verbs",
    "plugin",
    "fastify"
  ],
  "files": [
    "src"
  ],
  "author": "Stanislav Dzisiak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlet-components/fastify-method-override.git"
  },
  "homepage": "https://github.com/hexlet-components/fastify-method-override#readme",
  "bugs": {
    "url": "https://github.com/hexlet-components/fastify-method-override/issues"
  },
  "devDependencies": {
    "@fastify/formbody": "^9.0.0",
    "fastify": "^5.12.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "fastify": "5.x"
  },
  "packageManager": "pnpm@12.6.0"
}
